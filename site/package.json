{
  "name": "deploiable-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-brand-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "posters": "node scripts/make-posters.mjs",
    "film": "node scripts/render-film.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
